import os

ARQUIVO_DADOS = "dados.txt"
DELIMITADOR = ";"

def criar_arquivo_exemplo():
    """Cria um arquivo .txt de teste caso ele ainda não exista no diretório."""
    if not os.path.exists(ARQUIVO_DADOS):
        conteudo = (
            "id;nome;categoria;preco\n"
            "1;Teclado Mecanico;Perifericos;250.00\n"
            "2;Mouse Gamer;Perifericos;120.00\n"
            "3;Monitor 24;Eletronicos;850.00\n"
            "4;Cadeira Ergonomica;Moveis;1200.00\n"
            "5;Fone de Ouvido;Eletronicos;90.00\n"
            "6;Webcam HD;Eletronicos;210.00\n"
        )
        with open(ARQUIVO_DADOS, "w", encoding="utf-8") as f:
            f.write(conteudo)

# ==============================================================================
# DESAFIO 1: "Full Table Scan" (SELECT *)
# ==============================================================================
def desafio_1_full_table_scan(caminho_arquivo):
    print("--- [DESAFIO 1] Full Table Scan (SELECT *) ---")
    try:
        with open(caminho_arquivo, "r", encoding="utf-8") as f:
            # Ler e formatar o cabeçalho
            cabecalho = f.readline().strip().split(DELIMITADOR)
            print(f"{cabecalho[0]:<5} | {cabecalho[1]:<20} | {cabecalho[2]:<15} | {cabecalho[3]:<10}")
            print("-" * 60)
            
            # Ler e formatar todas as linhas sequencialmente
            for linha in f:
                linha_limpa = linha.strip()
                if not linha_limpa:
                    continue  # Pula linhas em branco se houver
                
                reg = linha_limpa.split(DELIMITADOR)
                print(f"{reg[0]:<5} | {reg[1]:<20} | {reg[2]:<15} | {reg[3]:<10}")
    except FileNotFoundError:
        print(f"Erro: O arquivo '{caminho_arquivo}' não foi encontrado.")


# ==============================================================================
# DESAFIO 2: Busca por Chave Primária (WHERE id = X) com Early Exit
# ==============================================================================
def desafio_2_buscar_por_id(caminho_arquivo, id_procurado):
    print(f"\n--- [DESAFIO 2] Busca por Chave Primária (WHERE id = {id_procurado}) ---")
    try:
        with open(caminho_arquivo, "r", encoding="utf-8") as f:
            f.readline()  # Descarta o cabeçalho
            
            for num_linha, linha in enumerate(f, start=2):
                linha_limpa = linha.strip()
                if not linha_limpa:
                    continue
                
                reg = linha_limpa.split(DELIMITADOR)
                id_registro = reg[0]
                
                # Se encontrar a chave primária
                if id_registro == str(id_procurado):
                    print(f"[SUCESSO] Registro encontrado na linha {num_linha} do arquivo:")
                    print(f" -> ID: {reg[0]}")
                    print(f" -> Nome: {reg[1]}")
                    print(f" -> Categoria: {reg[2]}")
                    print(f" -> Preço: R$ {float(reg[3]):.2f}")
                    return  # Early Exit: encerra a função imediatamente
            
            # Se percorrer todo o arquivo sem encontrar
            print(f"[NÃO ENCONTRADO] O ID '{id_procurado}' não existe no arquivo.")
            
    except FileNotFoundError:
        print(f"Erro: O arquivo '{caminho_arquivo}' não foi encontrado.")


# ==============================================================================
# DESAFIO 3: Filtro e Projeção (SELECT coluna1, coluna2 WHERE condição)
# ==============================================================================
def desafio_3_filtro_e_projecao(caminho_arquivo, categoria_filtro, preco_minimo):
    print(f"\n--- [DESAFIO 3] Filtro e Projeção ---")
    print(f"Consulta: SELECT nome, preco WHERE categoria = '{categoria_filtro}' AND preco > {preco_minimo}\n")
    
    try:
        with open(caminho_arquivo, "r", encoding="utf-8") as f:
            f.readline()  # Descarta o cabeçalho
            
            print(f"{'NOME (Projeção)':<20} | {'PREÇO (Projeção)':<15}")
            print("-" * 40)
            
            encontrados = 0
            for linha in f:
                linha_limpa = linha.strip()
                if not linha_limpa:
                    continue
                
                _, nome, categoria, preco_str = linha_limpa.split(DELIMITADOR)
                preco = float(preco_str)
                
                # 1. Aplicando a Condição/Filtro (WHERE)
                if categoria.lower() == categoria_filtro.lower() and preco > preco_minimo:
                    # 2. Aplicando a Projeção (Exibe apenas Nome e Preço)
                    print(f"{nome:<20} | R$ {preco:<12.2f}")
                    encontrados += 1
            
            if encontrados == 0:
                print("Nenhum registro encontrado para os critérios fornecidos.")
            else:
                print(f"\nTotal de registros retornados: {encontrados}")
                
    except FileNotFoundError:
        print(f"Erro: O arquivo '{caminho_arquivo}' não foi encontrado.")


# ==============================================================================
# EXECUÇÃO DO PROGRAMA
# ==============================================================================
if __name__ == "__main__":
    # Garante que o arquivo de dados existe antes de rodar
    criar_arquivo_exemplo()

    # Execução do Desafio 1
    desafio_1_full_table_scan(ARQUIVO_DADOS)

    # Execução do Desafio 2 (Testando um ID existente e depois um inexistente)
    desafio_2_buscar_por_id(ARQUIVO_DADOS, id_procurado=3)
    desafio_2_buscar_por_id(ARQUIVO_DADOS, id_procurado=99)

    # Execução do Desafio 3
    desafio_3_filtro_e_projecao(
        ARQUIVO_DADOS, 
        categoria_filtro="Eletronicos", 
        preco_minimo=100.00
    )
